# ==========================================
# DATASPEAK - ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION (FastAPI)
# ------------------------------------------
# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Settings (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clerk Authentication (Server-Side Verification)
# Find these in your Clerk Dashboard -> API Keys & JWT Templates
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Primary LLM Provider: Groq (Ultra-Fast Inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM Provider: OpenRouter (Multi-Model Resilience)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# SQL Security & Guardrail Limits
DEFAULT_QUERY_ROW_LIMIT=100
MAX_QUERY_TIMEOUT_SECONDS=10

# Sample / Default Database Connection Strings
# Local SQLite:
DEMO_DATABASE_URL=sqlite+aiosqlite:///./demo_ecommerce.db

# Neon Serverless PostgreSQL (Example connection format with SSL):
# NEON_DATABASE_URL=postgresql+asyncpg://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase Managed PostgreSQL (Example pooled connection format with SSL):
# SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres.yourproject:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require


# ------------------------------------------
# FRONTEND CONFIGURATION (React + Vite)
# ------------------------------------------
# API Gateway Target
VITE_API_BASE_URL=http://localhost:8000

# Clerk Authentication (Client-Side Publishable Key)
# Find this in your Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# App Metadata
VITE_APP_ENV=development
